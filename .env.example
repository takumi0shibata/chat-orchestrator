OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# Absolute paths optional; defaults resolve relative to repository, independent of cwd.
# RUNTIME_CONFIG=/absolute/path/to/runtime.toml
# DATA_DIR=/absolute/path/to/app-managed-data
SANDBOX_IMAGE=chat-orchestrator-sandbox:local
SANDBOX_CPUS=4
SANDBOX_MEMORY=8g
SANDBOX_PIDS=256
COMMAND_TIMEOUT=600
COMMAND_TIMEOUT_MIN=60
RUN_TIMEOUT=3600
MAX_MODEL_ROUNDS=100
COMPACT_TOKEN_THRESHOLD=100000
MAX_OUTPUT_CHARS=64000
MAX_UPLOAD_BYTES=52428800
# Proxies apply to provider SDK calls, never the sandbox.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=
